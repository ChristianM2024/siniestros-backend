// ============================================================
// SISTEMA DE GESTION DE SINIESTROS - RENTING ECUADOR
// Esquema de base de datos (PostgreSQL) via Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// SEGURIDAD: Usuarios, Roles y Permisos por pantalla
// ------------------------------------------------------------

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // Admin, Supervisor, Operador, Consulta
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  usuarios    Usuario[]
  permisos    RolPantalla[]

  @@map("roles")
}

// Cada "pantalla" representa una vista del frontend (Dashboard, Reportar, Seguimiento, etc.)
// Esto reemplaza la navegación fija del Excel por permisos configurables.
model Pantalla {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique // "dashboard", "reportar_siniestro", "seguimiento", "base_datos", "vehiculos", "usuarios"
  nombre    String   // Nombre visible en el menu
  ruta      String   // Ruta del frontend, ej. "/siniestros/nuevo"
  icono     String?  // nombre de icono (lucide-react) para el menu
  orden     Int      @default(0)

  permisos  RolPantalla[]

  @@map("pantallas")
}

// Tabla puente: qué puede hacer cada rol en cada pantalla (ver / crear / editar / eliminar)
model RolPantalla {
  id         Int      @id @default(autoincrement())
  rolId      Int      @map("rol_id")
  pantallaId Int      @map("pantalla_id")
  puedeVer      Boolean @default(true)  @map("puede_ver")
  puedeCrear    Boolean @default(false) @map("puede_crear")
  puedeEditar   Boolean @default(false) @map("puede_editar")
  puedeEliminar Boolean @default(false) @map("puede_eliminar")

  rol      Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  pantalla Pantalla @relation(fields: [pantallaId], references: [id], onDelete: Cascade)

  @@unique([rolId, pantallaId])
  @@map("rol_pantalla")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  activo       Boolean  @default(true)
  ultimoLogin  DateTime? @map("ultimo_login")
  creadoEn     DateTime @default(now()) @map("creado_en")

  rol           Rol         @relation(fields: [rolId], references: [id])
  siniestrosCreados Siniestro[] @relation("SiniestroCreadoPor")
  historialAcciones SiniestroHistorial[]                              // <-- opuesto de SiniestroHistorial.usuario
  solicitudesFormularioEnviadas SolicitudFormulario[]                 // <-- opuesto de SolicitudFormulario.enviadoPor
  auditLogs     AuditLog[]

  @@map("usuarios")
}

// ------------------------------------------------------------
// CATALOGOS (equivalentes a las hojas CIUDADES / listas del Excel)
// ------------------------------------------------------------

model Ciudad {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos  Vehiculo[]
  siniestros Siniestro[]
  tallerCiudades TallerCiudad[]   // <-- agregar

  @@map("ciudades")
}

model Aseguradora {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("aseguradoras")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  celular   String?
  correo    String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  vehiculos Vehiculo[]

  @@map("clientes")
}

// --- NUEVOS CATALOGOS (agregados para los campos de contrato/vehículo) ---

model Administrador {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("administradores")
}

model GerenteCuenta {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("gerentes_cuenta")
}

model TipoActivo {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_activo")
}

model TipoCombustible {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_combustible")
}

// Automovil, Camion, Camioneta, SUV, Van...
model Clase {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  gamas     Gama[]
  vehiculos Vehiculo[]

  @@map("clases")
}

// Depende de Clase: "SUV Gama Alta" solo existe dentro de la clase SUV.
model Gama {
  id      Int    @id @default(autoincrement())
  nombre  String
  claseId Int    @map("clase_id")

  clase     Clase      @relation(fields: [claseId], references: [id], onDelete: Restrict)
  vehiculos Vehiculo[]

  @@unique([claseId, nombre])
  @@map("gamas")
}

model ProveedorCompra {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("proveedores_compra")
}

// Ejecutivo, Extremo Blindado, Mixto, Operativo...
model TipoOperacion {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_operacion")
}

// N/A, Nivel III A con runflats, etc.
model NivelBlindaje {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("niveles_blindaje")
}

// --- NUEVO: catálogo de Tipo de Siniestro ---
model TipoSiniestro {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  estado Boolean @default(true) // activo/inactivo

  siniestros Siniestro[]
  estatusSiniestro EstatusSiniestro[]   // <-- agregar
  @@map("tipos_siniestro")
}

model Transmision {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  vehiculos Vehiculo[]

  @@map("transmisiones")
}

// --- NUEVO: Taller y sus ciudades de cobertura ---
model Taller {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  activo Boolean @default(true)

  ciudades   TallerCiudad[]

  @@map("talleres")
}

// Un taller puede atender en varias ciudades (tabla puente)
model TallerCiudad {
  id       Int @id @default(autoincrement())
  tallerId Int @map("taller_id")
  ciudadId Int @map("ciudad_id")

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  ciudad Ciudad @relation(fields: [ciudadId], references: [id], onDelete: Restrict)

  puntosAtencion PuntoAtencionTaller[]
  siniestros     Siniestro[]

  @@unique([tallerId, ciudadId])
  @@map("taller_ciudades")
}

// Depende de la combinación Taller+Ciudad, no solo del taller
model PuntoAtencionTaller {
  id             Int    @id @default(autoincrement())
  nombre         String
  tallerCiudadId Int    @map("taller_ciudad_id")

  tallerCiudad TallerCiudad @relation(fields: [tallerCiudadId], references: [id], onDelete: Cascade)
  siniestros   Siniestro[]

  @@unique([tallerCiudadId, nombre])
  @@map("puntos_atencion_taller")
}

// --- NUEVO: catálogo plano de Estatus de Cobro al Cliente ---
model EstatusCobroCliente {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  siniestros Siniestro[]

  @@map("estatus_cobro_cliente")
}

// --- NUEVO: reemplaza el enum EstadoSiniestro. Cada estatus pertenece a un Tipo de Siniestro ---
model EstatusSiniestro {
  id              Int     @id @default(autoincrement())
  nombre          String
  tipoSiniestroId Int     @map("tipo_siniestro_id")
  orden           Int     @default(0)
  activo          Boolean @default(true)

  tipoSiniestro TipoSiniestro @relation(fields: [tipoSiniestroId], references: [id], onDelete: Cascade)
  siniestros    Siniestro[]

  @@unique([tipoSiniestroId, nombre])
  @@map("estatus_siniestro")
}

// ------------------------------------------------------------
// HOJA "VEHICULOS"
// ------------------------------------------------------------

model Vehiculo {
  id                Int       @id @default(autoincrement())
  placa             String    @unique
  marca             String
  modelo            String
  anio              Int?
  color             String?
  chasis            String?
  noMotor           String?   @map("no_motor")
  clienteId         Int?      @map("cliente_id")
  noContrato        String?   @map("no_contrato")
  ciudadId          Int?      @map("ciudad_id")
  aseguradoraId     Int?      @map("aseguradora_id")
  noPoliza          String?   @map("no_poliza")
  vencimientoPoliza DateTime? @map("vencimiento_poliza")
  estado            String    @default("Activo") // Activo, Inactivo, Baja
  transmisionId Int?
  transmision   Transmision? @relation(fields: [transmisionId], references: [id])
  ram           String?
  
  // --- NUEVO: datos de contrato/cotización ---
  noAnexo             String?   @map("no_anexo")
  noCotizacion        String?   @map("no_cotizacion")
  noFactura           String?   @map("no_factura")
  fechaInicioContrato DateTime? @map("fecha_inicio_contrato")
  fechaFinContrato    DateTime? @map("fecha_fin_contrato")
  kmAnualContratado   Int?      @map("km_anual_contratado")

  // --- NUEVO: catálogos ---
  administradorId   Int? @map("administrador_id")
  gerenteCuentaId   Int? @map("gerente_cuenta_id")
  tipoActivoId      Int? @map("tipo_activo_id")
  tipoCombustibleId Int? @map("tipo_combustible_id")
  claseId           Int? @map("clase_id")
  gamaId            Int? @map("gama_id")
  proveedorCompraId Int? @map("proveedor_compra_id")
  tipoOperacionId   Int? @map("tipo_operacion_id")
  nivelBlindajeId   Int? @map("nivel_blindaje_id")

  // --- NUEVO: banderas ---
  blindaje  Boolean @default(false)
  sustituto Boolean @default(false)

  creadoEn DateTime @default(now()) @map("creado_en")

  ciudad          Ciudad?          @relation(fields: [ciudadId], references: [id])
  aseguradora     Aseguradora?     @relation(fields: [aseguradoraId], references: [id])
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  administrador   Administrador?   @relation(fields: [administradorId], references: [id])
  gerenteCuenta   GerenteCuenta?   @relation(fields: [gerenteCuentaId], references: [id])
  tipoActivo      TipoActivo?      @relation(fields: [tipoActivoId], references: [id])
  tipoCombustible TipoCombustible? @relation(fields: [tipoCombustibleId], references: [id])
  clase           Clase?           @relation(fields: [claseId], references: [id])
  gama            Gama?            @relation(fields: [gamaId], references: [id])
  proveedorCompra ProveedorCompra? @relation(fields: [proveedorCompraId], references: [id])
  tipoOperacion   TipoOperacion?   @relation(fields: [tipoOperacionId], references: [id])
  nivelBlindaje   NivelBlindaje?   @relation(fields: [nivelBlindajeId], references: [id])

  siniestros             Siniestro[]
  solicitudesFormulario  SolicitudFormulario[]

  @@map("vehiculos")
}

// distingue si el siniestro lo creó el staff internamente
// o si llegó por el formulario público que llena el cliente
enum OrigenSiniestro {
  INTERNO
  PUBLICO
}

model Siniestro {
  id               Int       @id @default(autoincrement())
  noSiniestro      String    @unique @map("no_siniestro") // generado: SIN-NNN

  vehiculoId       Int       @map("vehiculo_id")
  fechaSiniestro   DateTime  @map("fecha_siniestro")

  conductor        String
  cedulaConductor  String?   @map("cedula_conductor")
  telConductor     String?   @map("tel_conductor")
  correoConductor  String?   @map("correo_conductor")
  licenciaConductor    String?   @map("licencia_conductor")
  categoriaLicencia    String?   @map("categoria_licencia")
  vencimientoLicencia  DateTime? @map("vencimiento_licencia")
  lugarAccidente   String    @map("lugar_accidente")
  ciudadId         Int?      @map("ciudad_id")
  descripcion      String?
  danosVehiculo    String?   @map("danos_vehiculo")
  danosTerceros    String?   @map("danos_terceros")
  intervinoPolicia Boolean   @default(false) @map("intervino_policia")
  heridos          Boolean   @default(false)
  // --- NUEVO: los 2 campos Sí/No pedidos ---
  tieneCotizacion  Boolean   @default(false) @map("tiene_cotizacion")
  movilizadoGrua   Boolean   @default(false) @map("movilizado_grua")
  fechaNotifAseg     DateTime? @map("fecha_notif_aseg")
  fechaIngresoTaller DateTime? @map("fecha_ingreso_taller")
  fechaProforma      DateTime? @map("fecha_proforma")
  fechaAutorizacion  DateTime? @map("fecha_autorizacion")
  fechaEntrega       DateTime? @map("fecha_entrega")
  // ELIMINADO: estado EstadoSiniestro @default(Reportado)
  // NUEVO: reemplaza el enum, catálogo filtrado por tipoSiniestroId
  estatusSiniestroId Int? @map("estatus_siniestro_id")
  notas           String?
  origen          OrigenSiniestro @default(INTERNO) @map("origen")
  tipoSiniestroId Int?            @map("tipo_siniestro_id")
  // --- NUEVO: catálogos de esta sesión ---
  estatusCobroClienteId Int? @map("estatus_cobro_cliente_id")
  tallerCiudadId        Int? @map("taller_ciudad_id")
  puntoAtencionTallerId Int? @map("punto_atencion_taller_id")
  creadoPorId Int?     @map("creado_por_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  vehiculo      Vehiculo       @relation(fields: [vehiculoId], references: [id])
  ciudad        Ciudad?        @relation(fields: [ciudadId], references: [id])
  creadoPor     Usuario?       @relation("SiniestroCreadoPor", fields: [creadoPorId], references: [id])
  tipoSiniestro TipoSiniestro? @relation(fields: [tipoSiniestroId], references: [id])

  // --- NUEVO: relaciones ---
  estatusSiniestro    EstatusSiniestro?    @relation(fields: [estatusSiniestroId], references: [id], onDelete: SetNull)
  estatusCobroCliente EstatusCobroCliente? @relation(fields: [estatusCobroClienteId], references: [id], onDelete: SetNull)
  tallerCiudad        TallerCiudad?        @relation(fields: [tallerCiudadId], references: [id], onDelete: SetNull)
    // --- NUEVO: KPI / Fechas de proceso (Tipo Simple) ---
  fechaLlegadaRepuestos DateTime? @map("fecha_llegada_repuestos")
  fechaAuditoria        DateTime? @map("fecha_auditoria")
  fechaFiniquito        DateTime? @map("fecha_finiquito")
  fechaSalidaTaller     DateTime? @map("fecha_salida_taller")

  // --- NUEVO: Valores (Tipo Simple) ---
  valorSiniestroAntesIva   Float?  @map("valor_siniestro_antes_iva")
  valorAseguradoVehiculo   Float?  @map("valor_asegurado_vehiculo")
  valorDeducible           Float?  @map("valor_deducible") // calculado en backend, no es columna generada por SQL
  esCandidatoPerdidaTotal  Boolean? @map("es_candidato_perdida_total")

  // --- NUEVO: Cobro al Cliente (Tipo Simple) ---
  fechaNotifCobroCliente        DateTime? @map("fecha_notif_cobro_cliente")
  noOrdenServicioCobroCliente   String?   @map("no_orden_servicio_cobro_cliente")

  // --- NUEVO: Vehículo Sustituto (Tipo Simple) ---
  seEntregoVehiculoSustituto  Boolean?  @map("se_entrego_vehiculo_sustituto")
  fechaHoraEntregaSustituto   DateTime? @map("fecha_hora_entrega_sustituto")
  horasReclamoHastaEntrega    Float?    @map("horas_reclamo_hasta_entrega") // calculado en backend
  fechaRetiroSustituto        DateTime? @map("fecha_retiro_sustituto")
  puntoAtencionTaller PuntoAtencionTaller? @relation(fields: [puntoAtencionTallerId], references: [id], onDelete: SetNull)

  // --- NUEVO: Datos del Tercero (Tipo RC atendido por aseguradora del tercero) ---
  placaTercero           String?  @map("placa_tercero")
  marcaModeloTercero     String?  @map("marca_modelo_tercero")
  nombreTerceroCausante  String?  @map("nombre_tercero_causante")
  terceroAfectoPoliza    Boolean? @map("tercero_afecto_poliza")

  aseguradoraTercero    String? @map("aseguradora_tercero")
  polizaTercero         String? @map("poliza_tercero")
  tallerTerceroEstadia  String? @map("taller_tercero_estadia")

  // --- NUEVO: Valores adicionales (Tipo 005 — Posible pérdida total por daños) ---
  valorIndemnizadoPT1          Float? @map("valor_indemnizado_pt1")
  valorPendienteIndemnizacionPT2 Float? @map("valor_pendiente_indemnizacion_pt2") // calculado en backend

  // --- NUEVO: Pérdida Total - Proceso (Tipo 005) ---
  motivoPerdidaTotal                  String?   @map("motivo_perdida_total")
  fechaDeclaratoriaPerdidaTotal        DateTime? @map("fecha_declaratoria_perdida_total")
  solicitudCambioEstatusKimerasoft     Boolean?  @map("solicitud_cambio_estatus_kimerasoft")
  fechaSolicitudCambioEstatusKimerasoft DateTime? @map("fecha_solicitud_cambio_estatus_kimerasoft")
  notificacionRetiroSustitutoPT        DateTime? @map("notificacion_retiro_sustituto_pt")
  gestionRenovacionVehiculo            String?   @map("gestion_renovacion_vehiculo")
  fechaRetiroSustitutoPT               DateTime? @map("fecha_retiro_sustituto_pt")

  // --- NUEVO: Pérdida Total - Prenda bancaria (Tipo 005) ---
  entregaEstadoFinancieroBancoPrenda Boolean?  @map("entrega_estado_financiero_banco_prenda")
  nombreBancoPrenda                  String?   @map("nombre_banco_prenda")
  fechaSolicitudLiberacionPrenda     DateTime? @map("fecha_solicitud_liberacion_prenda")
  cartaLevantamientoPrendaBanco      String?   @map("carta_levantamiento_prenda_banco")
  tramiteLiberacionPrenda            String?   @map("tramite_liberacion_prenda")
  entregaChequeFinanciero            String?   @map("entrega_cheque_financiero")

  // --- NUEVO: Pérdida Total - Documentos (Tipo 005) ---
  docCuvFinal                  String? @map("doc_cuv_final")
  docCertificadoGravamen       String? @map("doc_certificado_gravamen")
  docOriginalMatricula         String? @map("doc_original_matricula")
  docCopiaCiPvRucRl            String? @map("doc_copia_ci_pv_ruc_rl")
  docComprobantePagoMatricula  String? @map("doc_comprobante_pago_matricula")
  docOriginalCopiaLlave        String? @map("doc_original_copia_llave")
  docCopiaFacturaVenta         String? @map("doc_copia_factura_venta")
  docVehiculoSinMultas         String? @map("doc_vehiculo_sin_multas")
  entregaDocumentosBroker      String? @map("entrega_documentos_broker")
  porcentajeAvanceChecklist    Float?  @map("porcentaje_avance_checklist") // calculado en backend

  // --- NUEVO: Pérdida Total - Notaría y cierre (Tipo 005) ---
  firmaContratoCompraVentaNotaria    String?   @map("firma_contrato_compra_venta_notaria")
  fechaPagoPerdidaTotal              DateTime? @map("fecha_pago_perdida_total")
  cambioEstatusPTotal                String?   @map("cambio_estatus_p_total")
  cambioEstatusFinalTotalVendido     Boolean?  @map("cambio_estatus_final_total_vendido")

// --- NUEVO: Robo (Tipo 006 — Siniestro posible pérdida total por robo) ---
  fechaDenunciaRobo                     DateTime? @map("fecha_denuncia_robo")
  numeroDenuncia                        String?   @map("numero_denuncia")
  vehiculoRecuperado                    Boolean?  @map("vehiculo_recuperado")
  fechaRecuperacion                     DateTime? @map("fecha_recuperacion")
  vehiculoDetenidoTrasRecuperacion      Boolean?  @map("vehiculo_detenido_tras_recuperacion")
  estadoVehiculoRecuperado              String?   @map("estado_vehiculo_recuperado") // "Con daños" / "Sin daños"
  deducibleRoboComponentesElectronicos  Float?    @map("deducible_robo_componentes_electronicos") // calculado en backend, fórmula pendiente

  // --- NUEVO: KPI reducido (Tipo 007 — Detención con heridos/fallecidos, afecta a tercero) ---
  totalTiempoSiniestro                Float?    @map("total_tiempo_siniestro") // calculado en backend, fórmula pendiente

  // --- NUEVO: Legal / Vehículo Detenido (Tipo 007) ---
  causalDetencion                       String?   @map("causal_detencion") // Daños terceros/propios / Lesionados / Fallecidos / Embriaguez / Daños propiedad pública / Abandono / Robo recuperado
  requiereAcompanamientoAbogadoPenal     Boolean?  @map("requiere_acompanamiento_abogado_penal")
  confirmacionAcompanamientoAbogadoPenal DateTime? @map("confirmacion_acompanamiento_abogado_penal")
  abogadoAsignado                       String?   @map("abogado_asignado")
  fechaSeguimientoPartePolicial          DateTime? @map("fecha_seguimiento_parte_policial")
  fechaEnvioParteBroker                  DateTime? @map("fecha_envio_parte_broker")
  fechaAsignacionFiscalia                DateTime? @map("fecha_asignacion_fiscalia")
  fechaOrdenLiberacion                   DateTime? @map("fecha_orden_liberacion")
  valorCancelarParqueadero                Float?   @map("valor_cancelar_parqueadero")
  valorCancelarGrua                       Float?   @map("valor_cancelar_grua")
  fechaLiberacionVehiculo                 DateTime? @map("fecha_liberacion_vehiculo")
  seguimientoIndemnizacionTercero         String?   @map("seguimiento_indemnizacion_tercero")

  // --- NUEVO: Tasa Spatt / Heridos-Fallecidos (Tipo 007) ---
  hayPersonasLesionadas                Boolean?  @map("hay_personas_lesionadas")
  numeroOcupantesLesionados            Int?      @map("numero_ocupantes_lesionados")
  coberturaTasaSpattOcupanteLesionado  Float?    @map("cobertura_tasa_spatt_ocupante_lesionado") // calculado en backend, fórmula pendiente
  hayPersonasFallecidas                Boolean?  @map("hay_personas_fallecidas")
  numeroFallecidos                     Int?      @map("numero_fallecidos")
  coberturaTodoRiesgoFallecido         Float?    @map("cobertura_todo_riesgo_fallecido") // calculado en backend, fórmula pendiente
  gastosFunerariosFallecido            Float?    @map("gastos_funerarios_fallecido") // calculado en backend, fórmula pendiente
  gastosAmbulancia                     Float?    @map("gastos_ambulancia") // calculado en backend, fórmula pendiente
  limiteSeguroTodoRiesgoSiSuperaSpatt  Float?    @map("limite_seguro_todo_riesgo_si_supera_spatt") // calculado en backend, fórmula pendiente
  historiaClinicaSolicitada            Boolean?  @map("historia_clinica_solicitada")
  fechaPagoFacturasTasaSpatt           DateTime? @map("fecha_pago_facturas_tasa_spatt")

  // --- NUEVO: Legal / Vehículo Detenido (Tipo 008 — Detención con heridos/fallecidos, el tercero afecta al usuario ISIRENT) ---
  // (El Tipo 008 reutiliza TODOS los campos ya agregados para el Tipo 007 —
  //  Legal / Vehículo Detenido y Tasa Spatt / Heridos-Fallecidos, ver schema-agregar-007.prisma —
  //  solo se agrega este campo nuevo, que reemplaza a "seguimientoIndemnizacionTercero" cuando el tipo es 008)
  seguimientoIndemnizacionUsuario String? @map("seguimiento_indemnizacion_usuario")

  // --- NUEVO: campos requeridos por las fórmulas de negocio (ver mensaje del cliente con la hoja de ejemplo) ---

  // Usado para elegir el tramo de "Valor deducible" (1er/2do/3er evento del cliente)
  numeroEventoCliente        Int?      @map("numero_evento_cliente")

  // Días en taller = Fecha_Salida_Taller - Fecha_Ingreso_Taller (Tipos 001, 002, 003, 004)
  diasTaller                  Float?    @map("dias_taller") // calculado en frontend al guardar

  // Fecha y hora del reclamo del vehículo sustituto (distinta de Fecha Notif. Aseg.)
  // usada junto con fechaHoraEntregaSustituto para "Horas desde el reclamo hasta la entrega"
  fechaHoraReclamo             DateTime? @map("fecha_hora_reclamo")

  // ¿Cumple KPI de 6 horas del vehículo sustituto? ("En KPI" / "Fuera de KPI")
  cumpleKpi6Horas              String?   @map("cumple_kpi_6_horas") // calculado en frontend al guardar



  documentos       SiniestroDocumento[]
  historialEstados SiniestroHistorial[]
  solicitudFormulario SolicitudFormulario?

  @@map("siniestros")
  @@index([estatusSiniestroId])
  @@index([vehiculoId])
  @@index([origen])
}

// Los "Tiempo A/B/C/Total" del Excel NO se guardan como columnas fijas:
// se calculan en la app (backend) a partir de las fechas de arriba,
// igual que las formulas de la hoja SEGUIMIENTO. Esto evita datos
// desincronizados. Se exponen via la API como campos calculados.

// Documentos requeridos (seccion 5 del formulario REPORTAR SINIESTRO)
model SiniestroDocumento {
  id          Int      @id @default(autoincrement())
  siniestroId Int      @map("siniestro_id")
  tipo        String   // foto_siniestro, foto_vehiculo, foto_conductor, foto_licencia, foto_matricula, croquis, acta_policial
  url         String   // ruta/S3 key del archivo
  subidoEn    DateTime @default(now()) @map("subido_en")

  siniestro Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)

  @@map("siniestro_documentos")
}

// Bitacora de cambios de estado (para trazabilidad, no existe en el Excel pero es
// buena practica para un sistema real de seguimiento)
model SiniestroHistorial {
  id          Int      @id @default(autoincrement())
  siniestroId Int      @map("siniestro_id")
  estadoAnterior String? @map("estado_anterior")
  estadoNuevo    String  @map("estado_nuevo")
  nota           String?

  // La entrada de historial que se crea al guardar
  // un siniestro del formulario público no tiene un usuario del sistema detrás.
  usuarioId      Int?     @map("usuario_id")
  creadoEn       DateTime @default(now()) @map("creado_en")

  siniestro Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("siniestro_historial")
}

// ------------------------------------------------------------
// Solicitudes del formulario público
// El staff busca un vehiculo por placa y dispara un link único
// (por correo y/o WhatsApp) para que el cliente reporte el siniestro
// ------------------------------------------------------------
model SolicitudFormulario {
  id              Int      @id @default(autoincrement())
  token           String   @unique @default(uuid())

  vehiculoId      Int      @map("vehiculo_id")
  enviadoPorId    Int      @map("enviado_por_id") // el staff que lo envía, sí requiere usuario

  correoCliente   String?  @map("correo_cliente")
  telefonoCliente String?  @map("telefono_cliente")
  canal           String   // "CORREO" | "WHATSAPP" | "AMBOS"
  estado          String   @default("ENVIADO") @map("estado") // ENVIADO | COMPLETADO | EXPIRADO

  expiraEn DateTime @map("expira_en")
  creadoEn DateTime @default(now()) @map("creado_en")

  // Cuando el cliente completa el formulario, queda enlazado al siniestro creado
  siniestroId Int?       @unique @map("siniestro_id")
  siniestro   Siniestro? @relation(fields: [siniestroId], references: [id])

  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  enviadoPor Usuario  @relation(fields: [enviadoPorId], references: [id])

  @@map("solicitudes_formulario")
  @@index([estado])
  @@index([vehiculoId])
}

// ------------------------------------------------------------
// AUDITORÍA: quién hizo qué y cuándo
// ------------------------------------------------------------
model AuditLog {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?     @map("usuario_id")
  usuarioEmail String?  @map("usuario_email") // se conserva aunque el usuario se borre despues
  accion       String   // LOGIN_OK, LOGIN_FALLIDO, CREATE, UPDATE, DELETE
  entidad      String?  // "usuario", "siniestro", "vehiculo", etc.
  entidadId    String?  @map("entidad_id")
  detalle      Json?
  ip           String?
  creadoEn     DateTime @default(now()) @map("creado_en")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([usuarioId])
  @@index([creadoEn])
  @@index([entidad])
}
