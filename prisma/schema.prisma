// ============================================================
// SISTEMA DE GESTION DE SINIESTROS - RENTING ECUADOR
// Esquema de base de datos (PostgreSQL) via Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// SEGURIDAD: Usuarios, Roles y Permisos por pantalla
// ------------------------------------------------------------

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // Admin, Supervisor, Operador, Consulta
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  usuarios    Usuario[]
  permisos    RolPantalla[]

  @@map("roles")
}

// Cada "pantalla" representa una vista del frontend (Dashboard, Reportar, Seguimiento, etc.)
// Esto reemplaza la navegación fija del Excel por permisos configurables.
model Pantalla {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique // "dashboard", "reportar_siniestro", "seguimiento", "base_datos", "vehiculos", "usuarios"
  nombre    String   // Nombre visible en el menu
  ruta      String   // Ruta del frontend, ej. "/siniestros/nuevo"
  icono     String?  // nombre de icono (lucide-react) para el menu
  orden     Int      @default(0)

  permisos  RolPantalla[]

  @@map("pantallas")
}

// Tabla puente: qué puede hacer cada rol en cada pantalla (ver / crear / editar / eliminar)
model RolPantalla {
  id         Int      @id @default(autoincrement())
  rolId      Int      @map("rol_id")
  pantallaId Int      @map("pantalla_id")
  puedeVer      Boolean @default(true)  @map("puede_ver")
  puedeCrear    Boolean @default(false) @map("puede_crear")
  puedeEditar   Boolean @default(false) @map("puede_editar")
  puedeEliminar Boolean @default(false) @map("puede_eliminar")

  rol      Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  pantalla Pantalla @relation(fields: [pantallaId], references: [id], onDelete: Cascade)

  @@unique([rolId, pantallaId])
  @@map("rol_pantalla")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  activo       Boolean  @default(true)
  ultimoLogin  DateTime? @map("ultimo_login")
  creadoEn     DateTime @default(now()) @map("creado_en")

  rol           Rol         @relation(fields: [rolId], references: [id])
  siniestrosCreados Siniestro[] @relation("SiniestroCreadoPor")
  historialAcciones SiniestroHistorial[]                              // <-- opuesto de SiniestroHistorial.usuario
  solicitudesFormularioEnviadas SolicitudFormulario[]                 // <-- opuesto de SolicitudFormulario.enviadoPor
  auditLogs     AuditLog[]

  @@map("usuarios")
}

// ------------------------------------------------------------
// CATALOGOS (equivalentes a las hojas CIUDADES / listas del Excel)
// ------------------------------------------------------------

model Ciudad {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos  Vehiculo[]
  siniestros Siniestro[]

  @@map("ciudades")
}

model Aseguradora {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("aseguradoras")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  celular   String?
  correo    String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  vehiculos Vehiculo[]

  @@map("clientes")
}

// --- NUEVOS CATALOGOS (agregados para los campos de contrato/vehículo) ---

model Administrador {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("administradores")
}

model GerenteCuenta {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("gerentes_cuenta")
}

model TipoActivo {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_activo")
}

model TipoCombustible {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_combustible")
}

// Automovil, Camion, Camioneta, SUV, Van...
model Clase {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  gamas     Gama[]
  vehiculos Vehiculo[]

  @@map("clases")
}

// Depende de Clase: "SUV Gama Alta" solo existe dentro de la clase SUV.
model Gama {
  id      Int    @id @default(autoincrement())
  nombre  String
  claseId Int    @map("clase_id")

  clase     Clase      @relation(fields: [claseId], references: [id], onDelete: Restrict)
  vehiculos Vehiculo[]

  @@unique([claseId, nombre])
  @@map("gamas")
}

model ProveedorCompra {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("proveedores_compra")
}

// Ejecutivo, Extremo Blindado, Mixto, Operativo...
model TipoOperacion {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("tipos_operacion")
}

// N/A, Nivel III A con runflats, etc.
model NivelBlindaje {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  vehiculos Vehiculo[]

  @@map("niveles_blindaje")
}

// ------------------------------------------------------------
// HOJA "VEHICULOS"
// ------------------------------------------------------------

model Vehiculo {
  id                Int       @id @default(autoincrement())
  placa             String    @unique
  marca             String
  modelo            String
  anio              Int?
  color             String?
  chasis            String?
  noMotor           String?   @map("no_motor")
  clienteId         Int?      @map("cliente_id")
  noContrato        String?   @map("no_contrato")
  ciudadId          Int?      @map("ciudad_id")
  aseguradoraId     Int?      @map("aseguradora_id")
  noPoliza          String?   @map("no_poliza")
  vencimientoPoliza DateTime? @map("vencimiento_poliza")
  estado            String    @default("Activo") // Activo, Inactivo, Baja

  // --- NUEVO: datos de contrato/cotización ---
  noAnexo             String?   @map("no_anexo")
  noCotizacion        String?   @map("no_cotizacion")
  noFactura           String?   @map("no_factura")
  fechaInicioContrato DateTime? @map("fecha_inicio_contrato")
  fechaFinContrato    DateTime? @map("fecha_fin_contrato")
  kmAnualContratado   Int?      @map("km_anual_contratado")

  // --- NUEVO: catálogos ---
  administradorId   Int? @map("administrador_id")
  gerenteCuentaId   Int? @map("gerente_cuenta_id")
  tipoActivoId      Int? @map("tipo_activo_id")
  tipoCombustibleId Int? @map("tipo_combustible_id")
  claseId           Int? @map("clase_id")
  gamaId            Int? @map("gama_id")
  proveedorCompraId Int? @map("proveedor_compra_id")
  tipoOperacionId   Int? @map("tipo_operacion_id")
  nivelBlindajeId   Int? @map("nivel_blindaje_id")

  // --- NUEVO: banderas ---
  blindaje  Boolean @default(false)
  sustituto Boolean @default(false)

  creadoEn DateTime @default(now()) @map("creado_en")

  ciudad          Ciudad?          @relation(fields: [ciudadId], references: [id])
  aseguradora     Aseguradora?     @relation(fields: [aseguradoraId], references: [id])
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  administrador   Administrador?   @relation(fields: [administradorId], references: [id])
  gerenteCuenta   GerenteCuenta?   @relation(fields: [gerenteCuentaId], references: [id])
  tipoActivo      TipoActivo?      @relation(fields: [tipoActivoId], references: [id])
  tipoCombustible TipoCombustible? @relation(fields: [tipoCombustibleId], references: [id])
  clase           Clase?           @relation(fields: [claseId], references: [id])
  gama            Gama?            @relation(fields: [gamaId], references: [id])
  proveedorCompra ProveedorCompra? @relation(fields: [proveedorCompraId], references: [id])
  tipoOperacion   TipoOperacion?   @relation(fields: [tipoOperacionId], references: [id])
  nivelBlindaje   NivelBlindaje?   @relation(fields: [nivelBlindajeId], references: [id])

  siniestros             Siniestro[]
  solicitudesFormulario  SolicitudFormulario[]

  @@map("vehiculos")
}

// ------------------------------------------------------------
// HOJA "BASE DE DATOS" / "REPORTAR SINIESTRO" / "SEGUIMIENTO"
// ------------------------------------------------------------

enum EstadoSiniestro {
  Reportado
  En_Peritaje    @map("En Peritaje")
  En_Reparacion  @map("En Reparacion")
  Entregado
  Cerrado
}

// distingue si el siniestro lo creó el staff internamente
// o si llegó por el formulario público que llena el cliente
enum OrigenSiniestro {
  INTERNO
  PUBLICO
}

model Siniestro {
  id               Int       @id @default(autoincrement())
  noSiniestro      String    @unique @map("no_siniestro") // generado: SIN-2026-001

  vehiculoId       Int       @map("vehiculo_id")
  fechaSiniestro   DateTime  @map("fecha_siniestro")

  // Datos del conductor (copiados al momento del reporte, no siempre igual al del vehiculo)
  conductor        String
  cedulaConductor  String?   @map("cedula_conductor")
  telConductor     String?   @map("tel_conductor")
  correoConductor  String?   @map("correo_conductor")               // lo pide el formulario público
  licenciaConductor    String?   @map("licencia_conductor")
  categoriaLicencia    String?   @map("categoria_licencia")
  vencimientoLicencia  DateTime? @map("vencimiento_licencia")

  lugarAccidente   String    @map("lugar_accidente")
  ciudadId         Int?      @map("ciudad_id")
  descripcion      String?

  danosVehiculo    String?   @map("danos_vehiculo")
  danosTerceros    String?   @map("danos_terceros")
  intervinoPolicia Boolean   @default(false) @map("intervino_policia")
  heridos          Boolean   @default(false)

  // Flujo de fechas -> usado para calcular Tiempo A/B/C/Total
  fechaNotifAseg     DateTime? @map("fecha_notif_aseg")
  fechaIngresoTaller DateTime? @map("fecha_ingreso_taller")
  fechaProforma      DateTime? @map("fecha_proforma")
  fechaAutorizacion  DateTime? @map("fecha_autorizacion")
  fechaEntrega       DateTime? @map("fecha_entrega")

  estado  EstadoSiniestro @default(Reportado)
  notas   String?

  origen        OrigenSiniestro @default(INTERNO) @map("origen")

  // Un siniestro creado desde el formulario público
  // no tiene un usuario del sistema detrás.
  creadoPorId Int?     @map("creado_por_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  ciudad     Ciudad?  @relation(fields: [ciudadId], references: [id])
  creadoPor  Usuario? @relation("SiniestroCreadoPor", fields: [creadoPorId], references: [id])

  documentos       SiniestroDocumento[]
  historialEstados SiniestroHistorial[]
  solicitudFormulario SolicitudFormulario?    // opuesto de SolicitudFormulario.siniestro

  @@map("siniestros")
  @@index([estado])
  @@index([vehiculoId])
  @@index([origen])
}

// Los "Tiempo A/B/C/Total" del Excel NO se guardan como columnas fijas:
// se calculan en la app (backend) a partir de las fechas de arriba,
// igual que las formulas de la hoja SEGUIMIENTO. Esto evita datos
// desincronizados. Se exponen via la API como campos calculados.

// Documentos requeridos (seccion 5 del formulario REPORTAR SINIESTRO)
model SiniestroDocumento {
  id          Int      @id @default(autoincrement())
  siniestroId Int      @map("siniestro_id")
  tipo        String   // foto_siniestro, foto_vehiculo, foto_conductor, foto_licencia, foto_matricula, croquis, acta_policial
  url         String   // ruta/S3 key del archivo
  subidoEn    DateTime @default(now()) @map("subido_en")

  siniestro Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)

  @@map("siniestro_documentos")
}

// Bitacora de cambios de estado (para trazabilidad, no existe en el Excel pero es
// buena practica para un sistema real de seguimiento)
model SiniestroHistorial {
  id          Int      @id @default(autoincrement())
  siniestroId Int      @map("siniestro_id")
  estadoAnterior String? @map("estado_anterior")
  estadoNuevo    String  @map("estado_nuevo")
  nota           String?

  // La entrada de historial que se crea al guardar
  // un siniestro del formulario público no tiene un usuario del sistema detrás.
  usuarioId      Int?     @map("usuario_id")
  creadoEn       DateTime @default(now()) @map("creado_en")

  siniestro Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("siniestro_historial")
}

// ------------------------------------------------------------
// Solicitudes del formulario público
// El staff busca un vehiculo por placa y dispara un link único
// (por correo y/o WhatsApp) para que el cliente reporte el siniestro
// ------------------------------------------------------------
model SolicitudFormulario {
  id              Int      @id @default(autoincrement())
  token           String   @unique @default(uuid())

  vehiculoId      Int      @map("vehiculo_id")
  enviadoPorId    Int      @map("enviado_por_id") // el staff que lo envía, sí requiere usuario

  correoCliente   String?  @map("correo_cliente")
  telefonoCliente String?  @map("telefono_cliente")
  canal           String   // "CORREO" | "WHATSAPP" | "AMBOS"
  estado          String   @default("ENVIADO") @map("estado") // ENVIADO | COMPLETADO | EXPIRADO

  expiraEn DateTime @map("expira_en")
  creadoEn DateTime @default(now()) @map("creado_en")

  // Cuando el cliente completa el formulario, queda enlazado al siniestro creado
  siniestroId Int?       @unique @map("siniestro_id")
  siniestro   Siniestro? @relation(fields: [siniestroId], references: [id])

  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  enviadoPor Usuario  @relation(fields: [enviadoPorId], references: [id])

  @@map("solicitudes_formulario")
  @@index([estado])
  @@index([vehiculoId])
}

// ------------------------------------------------------------
// AUDITORÍA: quién hizo qué y cuándo
// ------------------------------------------------------------
model AuditLog {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?     @map("usuario_id")
  usuarioEmail String?  @map("usuario_email") // se conserva aunque el usuario se borre despues
  accion       String   // LOGIN_OK, LOGIN_FALLIDO, CREATE, UPDATE, DELETE
  entidad      String?  // "usuario", "siniestro", "vehiculo", etc.
  entidadId    String?  @map("entidad_id")
  detalle      Json?
  ip           String?
  creadoEn     DateTime @default(now()) @map("creado_en")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([usuarioId])
  @@index([creadoEn])
  @@index([entidad])
}
